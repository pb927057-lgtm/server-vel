# Firebase project ID usado por Firebase Admin
FIREBASE_PROJECT_ID=tu-project-id

# JSON completo de la cuenta de servicio Firebase Admin (o contenido Base64)
FIREBASE_SERVICE_ACCOUNT=

# Opcional: orígenes HTTPS autorizados separados por coma
RELAY_ALLOWED_ORIGINS=https://tu-dominio-netlify.netlify.app

# Render asigna PORT automáticamente; no es necesario configurarlo
