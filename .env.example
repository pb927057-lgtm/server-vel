# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — VEL 0.1 SISTEMA COMERCIAL Y SUSCRIPCIONES
# ==============================================================================
# IMPORTANTE: Estos valores deben configurarse en el panel de variables de entorno
# del proveedor de despliegue (Netlify > Site configuration > Environment variables).
# NUNCA ingresar claves privadas reales en el código del navegador, Blogger ni repositorios.

# ------------------------------------------------------------------------------
# 1. MERCADO PAGO (Variables privadas exclusivamente de servidor / Netlify)
# ------------------------------------------------------------------------------
# Access Token privado del vendedor en Mercado Pago (pendiente de configurar en Netlify)
MP_ACCESS_TOKEN=""

# Clave secreta para validación de firma HMAC SHA-256 en Webhooks x-signature (pendiente de configurar en Netlify)
MP_WEBHOOK_SECRET=""

# Tolerancia máxima de antigüedad (en segundos) del timestamp ts en x-signature (opcional; predeterminado: 172800 = 48 horas)
MP_WEBHOOK_MAX_AGE_SECONDS=""

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Servidor de suscripciones y control de acceso)
# ------------------------------------------------------------------------------
# Identificador del proyecto Firebase (pendiente de configurar en Netlify)
FIREBASE_PROJECT_ID=""

# Credencial JSON de cuenta de servicio o codificada en base64 (pendiente de configurar en Netlify)
FIREBASE_SERVICE_ACCOUNT=""

# ------------------------------------------------------------------------------
# 3. URLS Y CORS DEL PORTAL (Opcionales)
# ------------------------------------------------------------------------------
# URL base pública del sitio en Netlify (usada para notification_url del webhook)
APP_BASE_URL=""

# URL de retorno al portal VEL tras completar/cancelar el pago en Mercado Pago
VEL_PORTAL_RETURN_URL=""

# Origen adicional permitido por CORS además de https://proyecto-vel.blogspot.com
BLOGGER_ORIGIN=""

# ------------------------------------------------------------------------------
# 4. RELAY WEBSOCKET E2EE (Servidor Node.js persistente separado de Netlify)
# ------------------------------------------------------------------------------
# URL pública segura (wss://...) del servidor Relay desplegado (configurar en Netlify)
VEL_RELAY_WSS_URL=""

# Alternativa pública para build de Vite (opcional si se usa /api/relay-config con VEL_RELAY_WSS_URL)
VITE_VEL_RELAY_WSS_URL=""

# Puerto de escucha del proceso standalone server-vel/relay-server.ts (opcional; Railway/Render inyectan PORT)
RELAY_PORT="8080"

# Lista separada por comas de orígenes permitidos para conexiones WebSocket (ej: https://legendary-pasca-bf280b.netlify.app)
RELAY_ALLOWED_ORIGINS=""
