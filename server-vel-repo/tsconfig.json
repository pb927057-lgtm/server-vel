{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "relay-server.ts",
    "test-relay.ts",
    "shared/**/*.ts",
    "contracts/**/*.ts",
    "crypto/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "test-data"
  ]
}
